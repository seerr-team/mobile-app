{
  "cli": {
    "version": ">= 14.7.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "android": {
        "buildType": "apk",
        "env": {
          "EXPO_TV": "1"
        }
      },
      "ios": {
        "env": {
          "EXPO_TV": "0"
        }
      }
    },
    "production-aab": {
      "extends": "production",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-tv": {
      "extends": "production",
      "ios": {
        "env": {
          "EXPO_TV": "1"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}
