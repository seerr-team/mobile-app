  "overrides": {
    "react-native": "npm:react-native-tvos@0.88-stable",
    "react-native-svg": "15.16.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js}": [
      "prettier --write"
    ],
    "**/*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native",
        "typescript"
      ]
    }
  },
  "engines": {
    "node": "^22.13.0"
