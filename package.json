{
  "name": "seerr-expo",
  "main": "expo-router/entry",
  "version": "0.11.2",
  "scripts": {
    "prebuild:android": "EXPO_TV=1 expo prebuild --clean --platform android",
    "prebuild:ios": "EXPO_TV=0 expo prebuild --clean --platform ios",
    "prebuild:ios:tv": "EXPO_TV=1 expo prebuild --clean --platform ios",
