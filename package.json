    "ios": "EXPO_TV=0 expo run:ios",
    "ios:tv": "EXPO_TV=1 expo run:ios",
    "lint": "eslint . --cache",
    "lintfix": "eslint . --fix",
    "format": "prettier --loglevel warn --write --cache .",
    "format:check": "prettier --check --cache .",
    "prepare": "husky",
    "seerr:changes": "node bin/seerr-changes.mjs"
  },
